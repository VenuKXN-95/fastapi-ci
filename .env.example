# ==============================================================================
# Environment Variable Reference
# DO NOT commit a populated .env file.  Copy this file to `.env` and fill in
# real values locally.  In CI/CD all values are injected via GitHub Secrets.
# ==============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="FastAPI CI Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"        # development | staging | production
DEBUG=false
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:8080"]'

# ---------------------------------------------------------------------------
# Security  (MANDATORY — CI will fail if absent)
# ---------------------------------------------------------------------------
SECRET_KEY="REPLACE_ME_minimum_32_chars_random_string"
JWT_SECRET="REPLACE_ME_minimum_32_chars_random_string"
API_KEY="REPLACE_ME_your_api_key_here"

# ---------------------------------------------------------------------------
# Database  (MANDATORY — CI will fail if absent)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/fastapi_db"
POSTGRES_URI="postgresql+asyncpg://user:password@localhost:5432/fastapi_db"
MONGODB_URI="mongodb://user:password@localhost:27017/fastapi_db"

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-REPLACE_ME"

# ---------------------------------------------------------------------------
# SonarQube  (CI only — set in GitHub Secrets, not here)
# ---------------------------------------------------------------------------
# SONAR_TOKEN=<set in GitHub Secrets>
# SONAR_HOST_URL=<set in GitHub Secrets>

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
WORKERS=1
